@model Kalendarz.Models.Kal

@{
    ViewData["Title"] = "Edycja wydarzenia";
}

<h1>Edytuj wydarzenie</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Udostepnianie.Udostepnij" /> @Html.DisplayNameFor(model => model.Udostepnianie.Udostepnij)
                </label>
            </div>
            <div class="form-group">
                <input style="margin-bottom : 5px" type="submit" value="Zapisz" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Details" asp-route-id="@Model?.ID" class="btn btn-info">Powrót</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

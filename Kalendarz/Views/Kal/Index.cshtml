@{
    ViewData["Title"] = "Twój kalendarz";
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> <!-- AJAX -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                height: 600,
                navLinks: true,
                initialView: 'dayGridMonth',
                events: '/Kal/GetEvents',
                headerToolbar: {        
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                eventDidMount: function(info) {
                    info.el.style.backgroundColor = info.event.extendedProps.backgroundColor;
                },
                eventClick: function (info) {
                window.location.href = '/Kal/Details/' + info.event.id;
            }
            });
            calendar.render();
        });
    </script>
</head>
<body>
    <h1 style="text-align : center">Twój kalendarz</h1>
    <div class="d-flex justify-content-center">
    <p >
        <a asp-action="Create" class="btn btn-primary">Dodaj nowe wydarzenie</a>
    </p>
    </div>
    <div id="calendar"></div>
</body>
</html>



@model Kalendarz.Models.TypWydarzenia

@{
    ViewData["Title"] = "Edycja typu";
}

<h1>Edit</h1>

<h4>TypWydarzenia</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="Nazwa" class="control-label"></label>
                <input asp-for="Nazwa" class="form-control" />
                <span asp-validation-for="Nazwa" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kolor" class="control-label"></label>
                <input asp-for="Kolor" class="form-control" />
                <span asp-validation-for="Kolor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input style="margin-bottom : 5px" type="submit" value="Zapisz" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-info">Powrót</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

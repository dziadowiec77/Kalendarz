@model IEnumerable<Kalendarz.Models.TypWydarzenia>

@{
    ViewData["Title"] = "Typy wydarzeń";
}

<h1 style="text-align : center">Twoje typy wydarzeń</h1>
<div class="d-flex justify-content-center">
<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj nowy typ</a>
</p>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nazwa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kolor)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nazwa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kolor)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-info">Edytuj</a> |
                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger">Usuń</a>
            </td>
        </tr>
}
    </tbody>
</table>

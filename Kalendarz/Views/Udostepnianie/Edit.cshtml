@model Kalendarz.Models.Udostepnianie

@{
    ViewData["Title"] = "Edycja udostępniania";
}

<h1>Edytuj Udostepnianie</h1>

<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Udostepnij" /> @Html.DisplayNameFor(model => model.Udostepnij)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label">Adresy email osob którym chcesz udostępnić wydarzenie<br>(adresy oddziel spacją / zostaw puste aby udostępnić wszystkim)</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input style="margin-bottom : 5px" type="submit" value="Zapisz" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-route-id="@Model?.KalId" asp-action="Details" asp-controller="Kal" class="btn btn-info">Powrót</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
